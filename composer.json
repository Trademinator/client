{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "trademinator/client",
    "description": "Read-only technology validation for the next Trademinator Client.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-gmp": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_sqlite": "*",
        "ccxt/ccxt": "^4.5",
        "react/async": "^4.3",
        "react/http": "^1.11",
        "react/promise-timer": "^1.11",
        "react/socket": "^1.17",
        "trademinator/bcmath": "^0.1.0",
        "trademinator/indicators": "^0.1.0"
    },
    "autoload": {
        "psr-4": {"Trademinator\\Client\\M0\\": "src/"},
        "files": ["compat/typephp-polyfills.php"]
    },
    "scripts": {
        "test": "@php tests/run.php",
        "lint": "@php tools/lint.php",
        "doctor": "@php bin/client.php doctor"
    },
    "config": {"sort-packages": true, "allow-plugins": false},
    "minimum-stability": "stable",
    "prefer-stable": true
}
