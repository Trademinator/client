{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "trademinator/client",
    "description": "Trademinator Client M2 authenticated Server intelligence and local core.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-gmp": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_sqlite": "*",
        "ccxt/ccxt": "^4.5",
        "react/async": "^4.3",
        "react/http": "^1.11",
        "react/promise-timer": "^1.11",
        "react/socket": "^1.17",
        "trademinator/bcmath": "^0.1.0",
        "trademinator/indicators": "^0.1.0"
    },
    "autoload": {
        "psr-4": {
            "Trademinator\\Client\\M0\\": "src/",
            "Trademinator\\Client\\M1\\": "m1/",
            "Trademinator\\Client\\M2\\": "m2/"
        },
        "files": [
            "compat/typephp-polyfills.php"
        ]
    },
    "scripts": {
        "test": [
            "@php tests/run.php",
            "@php tests/m1.php",
            "@php tests/m2.php"
        ],
        "lint": "@php tools/lint.php",
        "doctor": "@php bin/client.php doctor",
        "test:m0": "@php tests/run.php",
        "test:m1": "@php tests/m1.php",
        "doctor:m0": "@php bin/m0.php doctor",
        "test:m2": "@php tests/m2.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
